# 可选本机配置模板。所有值默认留空；真实 .env 不得提交。
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 可选的网站登录初始化。留空时使用程序默认值或手动创建管理员。
AUTH_ENABLED=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# 可选的公开行情后台预热。留空时默认启用，每 30 秒检查一次现有缓存。
PUBLIC_DATA_REFRESH_ENABLED=
PUBLIC_DATA_REFRESH_SECONDS=
