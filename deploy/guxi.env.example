# 非敏感生产默认值。复制到 /etc/guxi/guxi.env 后在服务器填写空值。
GUXI_OPEN_BROWSER=false
GUXI_DATA_DIR=/srv/guxi/shared
GUXI_LOG_LEVEL=INFO
AUTH_ENABLED=true
AUTH_DB_PATH=/srv/guxi/shared/data/auth.sqlite3
PUBLIC_BASE_URL=
ALLOWED_HOSTS=
TRUSTED_PROXIES=127.0.0.1,::1
SESSION_COOKIE_SECURE=true
SESSION_MAX_AGE=604800
SESSION_IDLE_TIMEOUT=86400
PASSWORD_MIN_LENGTH=10
PASSWORD_REQUIRE_MIXED=true
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=900
LOGIN_LOCK_SECONDS=900
TRADING_SETTINGS_PATH=/srv/guxi/shared/trading-settings.yaml
BINANCE_TESTNET=true
BINANCE_API_KEY=
BINANCE_API_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
